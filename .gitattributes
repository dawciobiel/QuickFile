# Set default behavior to auto-detect text files and enforce LF line endings.
* text=auto eol=lf

# Enforce LF line endings for specific text file types.
# This prevents "ghost" modifications in files on different OS.
*.json      text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.qss       text eol=lf
*.ui        text eol=lf
*.sh        text eol=lf
*.fish      text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.svg       text eol=lf

# Binary files - tell Git not to modify them.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.tiff      binary
*.webp      binary
*.qm        binary
