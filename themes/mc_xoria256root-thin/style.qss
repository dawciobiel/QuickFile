
QWidget {
    background-color: @@background@@;
    color: @@foreground@@;
}

QTableView, QTreeView {
    background-color: @@background@@;
    color: @@foreground@@;
    selection-background-color: @@selection_background@@;
    selection-color: @@selection_foreground@@;
    border: 1px solid @@border@@;
    show-decoration-selected: 1; /* Highlight selection */
}

QTableView {
    gridline-color: transparent; /* Hide default grid lines */
}

QTableView::item {
    border-bottom: 1px solid @@border@@; /* Dark horizontal line */
    border-right: 1px solid #FFFFFF; /* White vertical line */
}

QTableView[activePanel="true"]::item:selected, QTreeView[activePanel="true"]::item:selected {
    background-color: @@selection_background@@;
    color: @@selection_foreground@@;
}

QTableView[activePanel="false"]::item:selected, QTreeView[activePanel="false"]::item:selected {
    background-color: transparent;
    color: @@foreground@@;
}

QLineEdit[activePanel="true"] {
    background-color: @@selection_background@@;
    color: @@selection_foreground@@;
    border: 1px solid @@border@@;
}

QLineEdit[activePanel="false"] {
    background-color: @@background@@;
    color: @@foreground@@;
    border: 1px solid @@border@@;
}

QComboBox {
    background-color: @@background@@;
    color: @@foreground@@;
    border: 1px solid @@border@@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: @@border@@;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(styles/default/down_arrow.png); /* Placeholder, might need to be theme-specific */
}

QHeaderView::section {
    background-color: @@active_panel_background@@;
    color: @@accent@@;
    padding: 4px;
    border-bottom: 1px solid @@border@@; /* Dark bottom border */
    border-right: 1px solid #FFFFFF; /* White right border */
}

QSplitter::handle {
    background-color: @@border@@;
}

QGroupBox {
    color: @@accent@@;
    border: 1px solid @@border@@;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 3px;
    background-color: @@background@@;
}

QPushButton {
    background-color: @@active_panel_background@@;
    color: @@accent@@;
    border: 1px solid @@border@@;
    padding: 5px;
}

QPushButton:hover {
    background-color: @@selection_background@@;
    color: @@selection_foreground@@;
}

QDialog {
    background-color: @@background@@;
    color: @@foreground@@;
}

QMenuBar {
    background-color: @@background@@;
    color: @@foreground@@;
}

QMenuBar::item {
    background-color: @@background@@;
    color: @@foreground@@;
}

QMenuBar::item:selected {
    background-color: @@selection_background@@;
    color: @@selection_foreground@@;
}

QMenu {
    background-color: @@background@@;
    color: @@foreground@@;
    border: 1px solid @@border@@;
}

QMenu::item:selected {
    background-color: @@selection_background@@;
    color: @@selection_foreground@@;
}

QToolBar {
    background-color: @@background@@;
    border: none;
}

QStatusBar {
    background-color: @@active_panel_background@@;
    color: @@accent@@;
}

/* Active panel indicator */
QTableView[activePanel="true"], QTreeView[activePanel="true"] {
    border: 2px solid @@selection_background@@;
}

QTableView[activePanel="false"], QTreeView[activePanel="false"] {
    border: 2px solid @@border@@;
}
