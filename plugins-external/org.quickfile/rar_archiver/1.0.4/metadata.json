{
  "id": "org.quickfile.rar_archiver",
  "group_id": "org.quickfile",
  "artifact_id": "rar_archiver",
  "version": "1.0.4",
  "name": "RAR Archiver",
  "type": "archive",
  "description": "Provides support for extracting RAR archives.",
  "entry_point": "plugin:RarArchiverPlugin",
  "class_name": "RarArchiverPlugin",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "sandboxed": true,
  "python_dependencies": [
    "rarfile"
  ],
  "capabilities": [
    "archive.extract"
  ],
  "external_tools": [
    {
      "id": "rar_backend",
      "name": "RAR extraction backend",
      "executables": [
        "unrar",
        "unar",
        "bsdtar",
        "7z",
        "7zz"
      ]
    }
  ]
}
