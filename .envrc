#!/usr/bin/env bash
#
# QuickFile development environment.
#
# SINGLE SOURCE OF TRUTH: flake.nix
#
# Do not add `python -m venv`, `pip install`, `pip freeze` or PYTHONPATH here.
# Mixing Nix, pip and a hand-made virtualenv is what made the environment
# unreproducible in the past. If a dependency is missing, add it to
# flake.nix and run `direnv reload`.
#
# Run `direnv allow` after modifying this file.

use flake

if [ -t 1 ]; then
  echo "[direnv] QuickFile development environment ready."
  echo "[direnv] python: $(command -v python) ($(python -V 2>&1))"
fi
